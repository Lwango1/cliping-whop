# Config (contains API keys, passwords)
config.json

# Storage (downloaded videos, generated clips)
storage/raw/*
storage/processed/*
!storage/raw/.gitkeep
!storage/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Assets (binary files)
assets/*
!assets/manifest.json
!assets/icons/
!assets/sw.js

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
.env
venv/
.venv/

# Database (SQLite with user data)
data/*.db
data/*.db-wal
data/*.db-shm

# IDE
.vscode/
.idea/
*.swp
*.swo
